<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZeroAlloc.TestHelpers" Version="1.8.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- The generator tests compile against the reference set of the framework they run on, so the
         project's own ZeroAlloc.Notify build never targets a newer runtime than the references. -->
    <PackageReference Include="Basic.Reference.Assemblies.Net80" Version="1.8.13" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Basic.Reference.Assemblies.Net100" Version="1.8.13" Condition="'$(TargetFramework)' == 'net10.0'" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Notify.Generator\ZeroAlloc.Notify.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Notify\ZeroAlloc.Notify.csproj" />
    <PackageReference Include="ZeroAlloc.AsyncEvents" Version="1.1.11" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Snapshots are data, not code. Verify's targets excluded them from compilation; without
       that every .verified.cs is compiled and collides (CS0101). -->
  <ItemGroup>
    <Compile Remove="**/*.verified.*" />
    <Compile Remove="**/*.received.*" />
  </ItemGroup>

</Project>
